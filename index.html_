<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proyecto Elaboración de Materiales</title>
    <style>
        /* Configuración base y fondo con degradado moderno */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #333;
        }

        /* Contenedor principal tipo Card */
        .card {
            background-color: rgba(255, 255, 255, 0.95);
            padding: 2.5rem;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            max-width: 500px;
            width: 90%;
            text-align: center;
            box-sizing: border-box;
        }

        /* Título principal */
        h1 {
            margin-top: 0;
            color: #4a5568;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
        }

        /* Contenedor de los enlaces */
        .links-container {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        /* Estilo de los botones/enlaces */
        .btn {
            display: block;
            padding: 1rem 1.5rem;
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        /* Botón 1: CoSpaces (Tono azul/morado) */
        .btn-primary {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        }

        /* Botón 2: Evidencias (Tono rosa/morado) */
        .btn-secondary {
            background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
        }

        /* Efecto Hover (al pasar el ratón por encima) */
        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 7px 14px rgba(0, 0, 0, 0.15);
            opacity: 0.95;
        }

        /* Efecto Click */
        .btn:active {
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Proyecto de elaboración de materiales 2025/2026</h1>
		<h2>IES José Martín Recuerda</h2>
		<h3>Coordinación: Miguel Ángel Pamos Ureña</h3>
        
        <div class="links-container">
            <a href="rea/" class="btn btn-primary" target="_blank">
                REA: Creación de espacios virtuales con CoSpaces e inmersión con Gafas 3D
            </a>
            
            <a href="https://drive.google.com/drive/folders/1qePkfe0XiXr4e1M7ImTuQt77nd_OC_Wg?usp=sharing" class="btn btn-secondary" target="_blank">
                Evidencias del trabajo realizado
            </a>
        </div>
    </div>

</body>
</html>
